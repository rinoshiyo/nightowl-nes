# Review-bot (GitHub App) config. Copy to .env (gitignored) and fill in real values.
# The compose override injects these into the container via env_file: .env, and
# scripts/gh-app-token.sh reads them from the environment.

# GitHub App client id — used as the JWT issuer. Not a secret.
GH_APP_CLIENT_ID=Iv23xxxxxxxxxxxxxxxx

# Path INSIDE the container to the App private key PEM.
# The override ro-mounts host ~/.config/gh-app-keys to /home/node/.config/gh-app-keys.
GH_APP_KEY=/home/node/.config/gh-app-keys/<your-app>.private-key.pem

# owner/repo the App is installed on
GH_APP_REPO=rinoshiyo/nightowl-nes
