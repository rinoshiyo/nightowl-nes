# 中間生成物・一時ファイル
tmp/

# 設計書 (個人情報・社内情報を含むためリポ管理しない)
docs/design.md
docs/design.html

# ビルド成果物
dist/
node_modules/
.cache/
.parcel-cache/
.vite/

# Bun / Node 依存
bun.lockb.bak

# テスト・カバレッジ
coverage/
*.lcov

# ROM (合法所持品でも配布禁止)
roms/games/

# Claude Code 内部 state (リポ完結ポリシー、 内部状態は公開しない)
.claude/state/
.claude/cache/
.claude/retrospective/
.claude/*.lock

# 朝レポートの bak・一時ファイル
reports/morning/*.html.bak

# シークレット (混入事故防止)
.env
.env.*
!.env.example
*.pem
*.key
credentials*
secrets*

# Compose 個人 override (machine-local の鍵マウント・env_file 注入。 .example のみ commit)
compose.override.yaml
compose.override.yml

# IDE / OS
.DS_Store
# VSCode 設定は .devcontainer/devcontainer.json の customizations.vscode に集約 (.vscode/ は管理しない)
.vscode/
*.swp
*~
